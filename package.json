{
  "name": "submit-dependencies",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Submit Zolt's complete locked dependency graph to GitHub.",
  "author": "zoltsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoltsh/submit-dependencies.git"
  },
  "homepage": "https://github.com/zoltsh/submit-dependencies#readme",
  "bugs": {
    "url": "https://github.com/zoltsh/submit-dependencies/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "actionlint": "actionlint",
    "bundle": "ncc build src/index.ts -o dist --license licenses.txt",
    "bundle:check": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run bundle:check && npm run actionlint",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/http-client": "4.0.1",
    "packageurl-js": "2.0.1",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.44.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-rubric": "0.1.0-alpha.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
